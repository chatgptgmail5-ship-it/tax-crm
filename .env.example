# SQLite (default - no setup required)
DATABASE_URL="file:./dev.db"

# Required for authentication - generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-change-this"

# For local use only (this computer): http://localhost:3000
# For office network access: http://YOUR_PC_IP:3000 (e.g. http://192.168.1.100:3000)
NEXTAUTH_URL="http://localhost:3000"

